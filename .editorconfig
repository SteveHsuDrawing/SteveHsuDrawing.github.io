# EditorConfig — https://editorconfig.org
# Explicit editor defaults for this repository.  VS Code supports this
# natively; the Git-side rules live in .gitattributes.
#
# Policy: UTF-8 without BOM, LF line endings — except Windows batch
# scripts (legacy, CRLF).

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{cmd,bat}]
end_of_line = crlf

[*.py]
indent_size = 4

[*.md]
trim_trailing_whitespace = false
